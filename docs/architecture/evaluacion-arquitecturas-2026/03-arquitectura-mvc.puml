@startuml CAMPORA_MVC
title CAMPORA - Arquitectura MVC

left to right direction
skinparam componentStyle rectangle

actor "Usuario CAMPORA" as Usuario

package "Vista" as CapaVista {
  [PWA CAMPORA] as Vista
  [Catalogo de productos] as Catalogo
  [Formulario de pedidos] as Formulario
}

package "Controlador" {
  [AuthController] as Auth
  [OfferController] as Offer
  [OrderController] as Order
  [SearchController] as Search
}

package "Modelo" {
  [UsuarioModel] as UsuarioM
  [OfertaModel] as OfertaM
  [PedidoModel] as PedidoM
  [Reglas comerciales] as Reglas
}

package "Persistencia e integraciones" {
  database "PostgreSQL" as PG
  database "Redis" as Redis
  [Pasarelas de pago] as Pagos
}

Usuario --> Vista
Vista --> Catalogo
Vista --> Formulario

Vista --> Auth
Catalogo --> Search
Vista --> Offer
Formulario --> Order

Auth --> UsuarioM
Offer --> OfertaM
Order --> PedidoM
Search --> OfertaM

PedidoM --> Reglas
OfertaM --> Reglas

UsuarioM --> PG
OfertaM --> PG
PedidoM --> PG
Search --> Redis
PedidoM --> Pagos

@enduml
