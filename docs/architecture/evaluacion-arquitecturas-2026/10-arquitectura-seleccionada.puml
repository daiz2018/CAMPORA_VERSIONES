
@startuml CAMPORA_Seleccionada
title CAMPORA - Arquitectura hexagonal propuesta
left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle

actor "Productor / Comprador / Proveedor" as USUARIO

package "Interfaz de usuario" {
  [PWA CAMPORA] as PWA
  [Almacenamiento local\nIndexedDB] as LOCAL
}

package "Adaptadores de entrada" {
  [API REST] as API
  [Adaptador de sincronizacion] as SYNC
}

package "Nucleo de negocio" {
  [Puerto de entrada] as PIN

  package "Casos de uso" {
    [Gestionar ofertas] as OFERTAS
    [Gestionar pedidos] as PEDIDOS
    [Validar insumos] as ICA
    [Reglas comerciales] as REGLAS
  }

  [Puerto de persistencia] as PDB
  [Puerto de pagos] as PPAGO
  [Puerto de validacion] as PICA
}

package "Adaptadores de salida" {
  [Adaptador PostgreSQL] as SQL
  [Adaptador de pagos] as PAGOS
  [Adaptador ICA] as REG
}

database "PostgreSQL" as PG
cloud "Pasarela de pagos" as EXTPAGO
cloud "Servicio de consulta ICA" as EXTICA

USUARIO --> PWA
PWA --> LOCAL
PWA --> API
LOCAL --> SYNC
API --> PIN
SYNC --> PIN

PIN --> OFERTAS
PIN --> PEDIDOS
PIN --> ICA
OFERTAS --> REGLAS
PEDIDOS --> REGLAS

OFERTAS --> PDB
PEDIDOS --> PDB
PEDIDOS --> PPAGO
ICA --> PICA

SQL ..> PDB : implementa
PAGOS ..> PPAGO : implementa
REG ..> PICA : implementa

SQL --> PG
PAGOS --> EXTPAGO
REG --> EXTICA

@enduml
