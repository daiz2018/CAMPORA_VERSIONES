
@startuml CAMPORA_Hexagonal
title CAMPORA - Arquitectura Hexagonal
left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle

actor "Agricultor / Comprador" as Usuario

package "Adaptadores de entrada" {
  [PWA CAMPORA] as PWA
  [API REST] as API
  [Sincronización offline] as SYNC
}

package "Núcleo de negocio" {
  package "Puertos de entrada" {
    interface "Gestión de ofertas" as PO
    interface "Gestión de pedidos" as PP
    interface "Consulta de productos" as PC
  }

  package "Dominio CAMPORA" {
    [Reglas comerciales] as REGLAS
    [Control de inventario] as INVENTARIO
    [Validación de insumos] as ICA
  }

  package "Puertos de salida" {
    interface "Repositorio" as PR
    interface "Procesamiento de pagos" as PG
    interface "Búsqueda" as PB
  }
}

package "Adaptadores de salida" {
  [Persistencia PostgreSQL] as SQL
  [Pasarela de pagos externa] as PAGOS
  [Redis] as REDIS
}

Usuario --> PWA
PWA --> API
PWA --> SYNC

API --> PO
API --> PP
API --> PC
SYNC --> PO

PO --> REGLAS
PO --> INVENTARIO
PP --> REGLAS
PP --> INVENTARIO
PC --> REGLAS
REGLAS --> ICA

REGLAS --> PR
INVENTARIO --> PR
REGLAS --> PG
PC --> PB

SQL ..|> PR
PAGOS ..|> PG
REDIS ..|> PB

@enduml
